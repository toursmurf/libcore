# libcore v1.6 Valgrind Suppressions

# OpenSSL 전역 메모리 캐시 (Still Reachable) 무시
{
   OpenSSL_Still_Reachable_Malloc
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   ...
   obj:*/libcrypto.so*
}
{
   OpenSSL_Still_Reachable_Realloc
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:realloc
   ...
   obj:*/libcrypto.so*
}
{
   OpenSSL_Still_Reachable_Calloc
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:calloc
   ...
   obj:*/libcrypto.so*
}
{
   OpenSSL_Still_Reachable_Memalign
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:posix_memalign
   ...
   obj:*/libcrypto.so*
}
{
   OpenSSL_Still_Reachable_Memalign2
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:memalign
   ...
   obj:*/libcrypto.so*
}

# curl/libc 내부 dlopen 및 NSS 캐시 관련 false positive 제거
{
   curl_dlopen_cache
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_dl_load_cache_lookup
   ...
}

{
   curl_dlopen_new_object
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_dl_new_object
   ...
}

{
   curl_dlopen_check_versions
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_dl_check_map_versions
   ...
}

{
   curl_dlopen_catch_error
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_dl_catch_error
   ...
}
